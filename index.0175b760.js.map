"use strict";
var gallery = document.querySelector(".gallery");
var largeImg = document.getElementById("largeImg");
gallery.addEventListener("click", function(e) {
    var link = e.target.closest("a");
    if (!link) return;
    e.preventDefault();
    largeImg.src = link.href;
});

